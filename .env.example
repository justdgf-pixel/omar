# Database (SQLite for dev; switch to PostgreSQL for production)
DATABASE_URL="file:./prisma/dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# Signing key for one-time download URLs (long random string).
DOWNLOAD_SIGNING_SECRET="change-me-to-another-long-random-string"

# Where uploaded digital products are stored on disk.
# In production use S3-compatible storage (e.g. Wasabi, Cloudflare R2, Bunny Storage).
UPLOAD_DIR="./public/uploads"

# Algeria payment configuration (manual verification by default).
# CIB / Edahabia integrations go through SATIM (https://www.satim.dz/) — fill these in once you
# have a contract; the storefront falls back to manual confirmation if not set.
SATIM_MERCHANT_ID=""
SATIM_API_USER=""
SATIM_API_PASSWORD=""
SATIM_BASE_URL="https://test.satim.dz/payment/rest"

# Bank transfer details shown to buyers who pay by BaridiMob / CCP.
BANK_BENEFICIARY_NAME="Souqami SARL"
BANK_CCP_ACCOUNT="0000000000 00"
BANK_RIB=""
BANK_BARIDIMOB_PHONE=""

# Default seller payout fee (percent kept by the platform).
PLATFORM_FEE_PERCENT="10"
