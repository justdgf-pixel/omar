# Copy this to .env and fill in real values for production.
DATABASE_URL="file:./prisma/dev.db"

# At least 32 chars. Used to sign JWT auth cookies and download tokens.
AUTH_SECRET="change-me-to-a-long-random-string-32+chars"

# Public site URL (used for download links, OG, PWA, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Souk Digital DZ"

# ---- Algerian payment configuration ----------------------------------------
# Manual transfer instructions shown to buyers at checkout.
# (CCP = Compte Courant Postal, the most common Algerian bank account.)
PAYMENT_CCP_ACCOUNT="0012345678 / 12"
PAYMENT_CCP_HOLDER="SOUK DIGITAL DZ SARL"
PAYMENT_BARIDIMOB_RIP="00799999000123456789"
PAYMENT_RIB_BANK="BNA — Banque Nationale d'Algérie"
PAYMENT_RIB_ACCOUNT="000 000 0000000000 00"

# Optional: SATIM / CIB e-payment integration (placeholders).
# When empty, the storefront falls back to manual proof upload.
SATIM_MERCHANT_ID=""
SATIM_TERMINAL_ID=""
SATIM_API_USERNAME=""
SATIM_API_PASSWORD=""
SATIM_GATEWAY_URL="https://test.satim.dz/payment/rest"
