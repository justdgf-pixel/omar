# Database (SQLite for dev; switch provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Used to sign session cookies and download tokens. Generate a long random string.
APP_SECRET="change-me-to-a-long-random-string"

# Public site URL (for canonical links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Default currency / locale
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NEXT_PUBLIC_CURRENCY="DZD"

# Manual payment instructions (shown to buyers on checkout)
PAYMENT_CCP_ACCOUNT="0023456789 12 / clé 34"
PAYMENT_CCP_NAME="Souk Digital SARL"
PAYMENT_BARIDIMOB_RIP="00799999000123456789"

# Optional: SATIM / CIB-Edahabia gateway (sandbox stub by default)
SATIM_MERCHANT_ID=""
SATIM_API_KEY=""
SATIM_BASE_URL="https://test.satim.dz/payment/rest"
